{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NextProb/nextprob-plugin-registry/main/schemas/catalog.schema.json",
  "title": "NextProb plugin catalog",
  "description": "Signed marketplace catalog published on the catalog branch. The catalog is generated by the publish workflow, never edited by hand. Plugins and versions are ordered newest-first by semantic version. catalogVersion increments by one on each committed catalog change. The detached Ed25519 signature is published alongside the catalog as catalog.json.sig over canonical JSON.",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "generatedAt", "sourceCommit", "keyId", "plugins"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Catalog schema version."
    },
    "catalogVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing catalog revision, incremented on each committed change."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when this catalog revision was generated."
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1,
      "description": "Commit on main that produced this catalog revision."
    },
    "keyId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Identifier of the Ed25519 catalog signing key: SHA-256 of the SPKI DER public key, lowercase hex."
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      },
      "description": "Published plugins. Sorted by plugin id; versions are ordered newest-first by semantic version."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["id", "publisher", "official", "metadata", "versions"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))(?!.*\\.$)[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$",
          "description": "Stable plugin id."
        },
        "publisher": {
          "$ref": "#/$defs/publisher"
        },
        "official": {
          "type": "boolean",
          "description": "Derived from reviewed ownership; never taken from author-supplied metadata."
        },
        "metadata": {
          "$ref": "#/$defs/metadata",
          "description": "Current metadata.json contents for the plugin."
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/version"
          },
          "description": "Published versions, newest-first by semantic version. Older versions remain for compatibility and rollback."
        }
      },
      "additionalProperties": false
    },
    "publisher": {
      "type": "object",
      "required": ["id", "displayName", "official", "github", "url"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))(?!.*\\.$)[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "official": {
          "type": "boolean"
        },
        "github": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["publisher", "license", "categories", "summary", "releaseNotes"],
      "properties": {
        "publisher": {
          "type": "string",
          "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))(?!.*\\.$)[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["export", "publishing", "automation", "integration", "productivity", "developer", "theme"]
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "releaseNotes": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "deprecated": {
          "type": "boolean"
        },
        "withdrawn": {
          "type": "boolean"
        },
        "replacement": {
          "type": "string",
          "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))(?!.*\\.$)[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": [
        "version",
        "apiVersion",
        "execution",
        "nextprob",
        "platforms",
        "dependencies",
        "sourceCommit",
        "releaseTag",
        "publishedAt",
        "releaseNotes",
        "deprecated",
        "withdrawn",
        "assets"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "description": "Published semantic version."
        },
        "apiVersion": {
          "const": 1
        },
        "execution": {
          "enum": ["native", "subprocess"],
          "description": "Execution model derived from the runtime manifest entry points."
        },
        "nextprob": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic version range of compatible NextProb application versions."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64", "win32-arm64", "win32-x64"]
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "description": "Versioned registry plugin dependencies."
        },
        "sourceCommit": {
          "type": "string",
          "minLength": 1,
          "description": "Exact main commit that was packaged for this version."
        },
        "releaseTag": {
          "type": "string",
          "minLength": 1,
          "description": "GitHub release tag, <plugin-id>-v<version>."
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "releaseNotes": {
          "type": "string",
          "minLength": 1
        },
        "deprecated": {
          "type": "boolean"
        },
        "withdrawn": {
          "type": "boolean"
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["id", "range"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))(?!.*\\.$)[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"
        },
        "range": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["filename", "url", "sha256", "size", "platforms"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "description": "Release asset filename, <plugin-id>-<version>.zip."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Version-specific HTTPS download URL for the asset."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 digest of the ZIP archive, lowercase hex."
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Archive size in bytes."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64", "win32-arm64", "win32-x64"]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
