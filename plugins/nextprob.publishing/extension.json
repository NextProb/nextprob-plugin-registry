{
  "id": "nextprob.publishing",
  "name": "Publishing",
  "description": "Publishes notes online and manages GitHub publishing connections.",
  "version": "1.0.0",
  "nextprob": ">=0.4.0 <1.0.0",
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64",
    "win32-arm64",
    "win32-x64"
  ],
  "main": "main.cjs",
  "dependencies": [],
  "ipc": {
    "handle": [
      "export:publish",
      "export:unpublish",
      "notes:listPublished",
      "github:connect",
      "github:cancelConnect",
      "github:disconnect",
      "github:getState",
      "github:setRepoName",
      "github:checkRepoName",
      "github:provisionRepo"
    ],
    "on": [],
    "send": [
      "github:stateChanged"
    ]
  },
  "renderer": "renderer.js",
  "styles": [
    "renderer.css"
  ],
  "apiVersion": 1
}
