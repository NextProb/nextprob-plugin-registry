{
  "id": "nextprob.export-html",
  "name": "Export HTML",
  "description": "Saves notes as HTML files, including a single self-contained file.",
  "version": "1.0.1",
  "nextprob": ">=0.4.0 <1.0.0",
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-arm64",
    "linux-x64",
    "win32-arm64",
    "win32-x64"
  ],
  "main": "main.cjs",
  "dependencies": [
    "nextprob.export-engine"
  ],
  "dependencyVersions": {
    "nextprob.export-engine": ">=1.0.0 <2.0.0"
  },
  "ipc": {
    "handle": [
      "export:save-html",
      "export:single-html"
    ],
    "on": [],
    "send": []
  },
  "renderer": "renderer.js",
  "apiVersion": 1
}
